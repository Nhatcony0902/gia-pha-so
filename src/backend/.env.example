DATABASE_URL=postgresql://family_tree:family_tree@127.0.0.1:5432/family_tree?schema=public
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret
PASSWORD_RESET_SECRET=replace-with-a-third-random-secret
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Gia Pha So <no-reply@example.local>"
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NODE_ENV=development
# Chatbot (LMS-016, ADR-0005). Lấy key ở https://aistudio.google.com/apikey
# Để trống thì trang "Hỏi đáp AI" báo chưa bật, các chức năng khác vẫn chạy.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Phải khớp cột vector(768) trong DB. Đổi số chiều thì cần migration mới.
GEMINI_EMBEDDING_DIMENSIONS=768
# Số câu hỏi tối đa mỗi tài khoản mỗi ngày (mặc định 50)
AI_DAILY_QUESTION_LIMIT=50
# Số ảnh gửi kèm câu hỏi mỗi tài khoản mỗi ngày (LMS-019). 0 để tắt gửi ảnh.
AI_DAILY_IMAGE_LIMIT=10
# off: tắt search_content (vector search), chỉ dùng tool có cấu trúc
AI_CONTENT_SEARCH=on
# Tùy chọn: gọi Gemini qua proxy/server giả khi kiểm thử
GEMINI_BASE_URL=
