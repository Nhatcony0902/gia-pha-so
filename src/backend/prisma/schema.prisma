generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String
  passwordHash    String?
  googleSubject   String?              @unique
  emailVerifiedAt DateTime?
  avatarUrl       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  refreshSessions RefreshSession[]
  resetTokens     PasswordResetToken[]
  familyTrees     FamilyTree[]
  memberships     Membership[]
  invitations     Invitation[]
  createdEvents   FamilyEvent[]        @relation("EventCreator")
  eventGuests     EventGuest[]
  notifications   Notification[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum DatePrecision {
  YEAR
  MONTH
  DAY
}

enum ParentKind {
  BIOLOGICAL
  ADOPTIVE
}

enum MarriageStatus {
  MARRIED
  DIVORCED
  SEPARATED
  WIDOWED
}

model FamilyTree {
  id            String             @id @default(cuid())
  name          String
  description   String?
  coverUrl      String?
  originPlace   String?
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdBy     User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  persons       FamilyTreePerson[]
  relationships Relationship[]
  memberships   Membership[]
  invitations   Invitation[]
  events        FamilyEvent[]

  @@index([createdById, updatedAt])
}

enum EventCategory {
  DEATH_ANNIVERSARY
  REUNION
  CEREMONY
  WEDDING
  BIRTHDAY
  MEETING
  OTHER
}

enum EventMediaType {
  IMAGE
  DOCUMENT
}

model FamilyEvent {
  id              String        @id @default(cuid())
  treeId          String
  title           String
  category        EventCategory
  description     String?
  location        String?
  coverUrl        String?
  coverPublicId   String?
  startAt         DateTime
  endAt           DateTime?
  createdById     String
  notifiedAt      DateTime?
  endedNotifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tree            FamilyTree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  guests          EventGuest[]
  media           EventMedia[]

  @@index([treeId, startAt])
  @@index([notifiedAt, startAt])
  @@index([endedNotifiedAt, endAt])
}

model EventGuest {
  id         String      @id @default(cuid())
  eventId    String
  email      String
  userId     String?
  invitedAt  DateTime    @default(now())
  acceptedAt DateTime?
  declinedAt DateTime?
  event      FamilyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([userId])
}

model EventMedia {
  id           String         @id @default(cuid())
  eventId      String
  url          String
  publicId     String         @unique
  type         EventMediaType
  originalName String
  mimeType     String?
  format       String?
  bytes        Int?
  width        Int?
  height       Int?
  createdAt    DateTime       @default(now())
  event        FamilyEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String    @default("SYSTEM")
  sourceType String    @default("SYSTEM")
  sourceName String    @default("Hệ thống")
  title      String
  message    String
  actionUrl  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

enum TreeRole {
  ADMIN
  EDITOR
  VIEWER
}

model Membership {
  treeId   String
  userId   String
  role     TreeRole
  /// Person của chính user trong gia phả này
  personId String?
  joinedAt DateTime   @default(now())
  tree     FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  person   Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@id([treeId, userId])
  @@unique([treeId, personId])
  @@index([userId])
}

model Invitation {
  id          String     @id @default(cuid())
  treeId      String
  tokenHash   String     @unique
  role        TreeRole   @default(VIEWER)
  maxUses     Int?
  useCount    Int        @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  /// Có email: lời mời đích danh, chỉ tài khoản đúng email này chấp nhận được
  email       String?
  /// Gắn tài khoản người nhận với Person này khi chấp nhận
  personId    String?
  createdById String
  createdAt   DateTime   @default(now())
  tree        FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  person      Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([treeId, createdAt])
}

model Person {
  id                 String             @id @default(cuid())
  fullName           String
  preferredName      String?
  aliases            String[]           @default([])
  gender             Gender             @default(UNKNOWN)
  birthDate          DateTime?
  birthDatePrecision DatePrecision?
  birthPlace         String?
  deathDate          DateTime?
  deathDatePrecision DatePrecision?
  deathPlace         String?
  isDeceased         Boolean            @default(false)
  hometown           String?
  currentResidence   String?
  nationality        String?
  ethnicity          String?
  religion           String?
  occupation         String?
  title              String?
  maidenName         String?
  education          String?
  employer           String?
  phone              String?
  email              String?
  address            String?
  bloodType          String?
  identificationCode String?
  socialLinks        Json?
  biography          String?
  notes              String?
  burialPlace        String?
  avatarUrl          String?
  avatarPublicId     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  familyTrees        FamilyTreePerson[]
  relationshipsFrom  Relationship[]     @relation("RelationshipFrom")
  relationshipsTo    Relationship[]     @relation("RelationshipTo")
  images             PersonImage[]
  memberships        Membership[]
  invitations        Invitation[]

  @@index([fullName])
}

model PersonImage {
  id        String    @id @default(cuid())
  personId  String
  url       String
  publicId  String    @unique
  caption   String?
  takenAt   DateTime?
  width     Int?
  height    Int?
  format    String?
  bytes     Int?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, sortOrder])
}

model FamilyTreePerson {
  treeId                String
  personId              String
  joinedAt              DateTime       @default(now())
  tree                  FamilyTree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  person                Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  outgoingRelationships Relationship[] @relation("RelationshipFromMembership")
  incomingRelationships Relationship[] @relation("RelationshipToMembership")

  @@id([treeId, personId])
  @@index([personId])
}

model RelationshipType {
  code          String         @id
  label         String
  isDirected    Boolean
  relationships Relationship[]
}

model Relationship {
  id                 String           @id @default(cuid())
  treeId             String
  typeCode           String
  fromPersonId       String
  toPersonId         String
  parentKind         ParentKind?
  birthOrder         Int?
  marriageStatus     MarriageStatus?
  marriageOrder      Int?
  startedAt          DateTime?
  startedAtPrecision DatePrecision?
  endedAt            DateTime?
  endedAtPrecision   DatePrecision?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tree               FamilyTree       @relation(fields: [treeId], references: [id], onDelete: Cascade)
  type               RelationshipType @relation(fields: [typeCode], references: [code], onDelete: Restrict)
  fromPerson         Person           @relation("RelationshipFrom", fields: [fromPersonId], references: [id], onDelete: Restrict)
  toPerson           Person           @relation("RelationshipTo", fields: [toPersonId], references: [id], onDelete: Restrict)
  fromMembership     FamilyTreePerson @relation("RelationshipFromMembership", fields: [treeId, fromPersonId], references: [treeId, personId], onDelete: Cascade)
  toMembership       FamilyTreePerson @relation("RelationshipToMembership", fields: [treeId, toPersonId], references: [treeId, personId], onDelete: Cascade)

  @@unique([treeId, typeCode, fromPersonId, toPersonId])
  @@index([treeId, typeCode])
  @@index([fromPersonId])
  @@index([toPersonId])
}

enum VerificationPurpose {
  REGISTER
  PASSWORD_RESET
}

model VerificationChallenge {
  id                  String              @id @default(cuid())
  email               String
  purpose             VerificationPurpose
  codeHash            String
  pendingName         String?
  pendingPasswordHash String?
  attempts            Int                 @default(0)
  expiresAt           DateTime
  resendAvailableAt   DateTime
  usedAt              DateTime?
  createdAt           DateTime            @default(now())

  @@index([email, purpose, createdAt])
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  familyId   String
  secretHash String
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
